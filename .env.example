# PostgreSQL (Neon recommended for Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth (required)
AUTH_SECRET=
# Local dev: http://localhost:3000
# Vercel production: https://fundraising-builder.vercel.app
AUTH_URL=http://localhost:3000

# Stripe (required for payments)
STRIPE_SECRET_KEY=
# Optional — not used by Stripe Checkout redirect flow
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks → signing secret
# Endpoint URL: https://fundraising-builder.vercel.app/api/webhooks/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Email (optional — dev mode logs magic links to console)
RESEND_API_KEY=
