# Required — PostgreSQL (e.g. Neon)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required — NextAuth (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Required — App URL (e.g. http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"

# Optional — Stripe payments
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional — order receipt emails only (not required for sign-in)
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="Beadoughs <noreply@yourdomain.com>"
